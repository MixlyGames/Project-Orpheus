
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Orpheus",
  "version": "0.1.0",
  "identifier": "com.mixlygames.mebius",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Project Orpheus",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "OwlNestTeam",
    "copyright": "Copyright © 2026 OwlNestTeam",
    "shortDescription": "Project Orpheus",
    "longDescription": "Project Orpheus - desktop application by MixlyGames.",
    "license": "MIT",
    "licenseFile": "../LICENSE",

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],

    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "Russian"
        ],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
